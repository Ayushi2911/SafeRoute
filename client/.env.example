# SafeRoute Frontend Environment Configuration Template
# For Netlify or local production build, point this to your Render backend URL.
# Note: In Vite, environment variables exposed to the client MUST start with VITE_

# Backend API URL (no trailing slash)
VITE_API_URL=https://saferoute-backend-lgis.onrender.com

# Backward-compatible alternative alias:
VITE_API_BASE_URL=https://saferoute-backend-lgis.onrender.com
