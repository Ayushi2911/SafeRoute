# SafeRoute Server Environment Configuration Template
# For local development, copy this file to .env and set your local MySQL credentials.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL.

# Application Environment & Port
NODE_ENV=production
PORT=5000

# Client Frontend URL for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=saferoute

# JWT Secret for Administrative & User Sessions
JWT_SECRET=

# OSRM Routing Engine (defaults to public service if left blank)
OSRM_BASE_URL=https://router.project-osrm.org
